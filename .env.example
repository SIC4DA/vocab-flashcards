# Required. At least 32 random characters. Generate with: openssl rand -base64 32
# (Also used to encrypt users' saved Gemini keys — if you change it, users must re-enter their key.)
SESSION_SECRET=

# Postgres (set automatically by the Vercel Neon integration).
# Leave empty locally to use the embedded PGlite database (stored in ./.pglite).
DATABASE_URL=

# Optional: Gemini model names. Each user adds their OWN Gemini API key in Settings —
# there is no app-wide key.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Set to false to disable new sign-ups (after creating your own account).
ALLOW_SIGNUPS=true
